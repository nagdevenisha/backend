generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())
  fullname  String
}

model RadioPerCity {
  id    Int     @id @default(autoincrement())
  city  String?
  radio String?

  @@unique([city, radio])
}

model Team {
  id                Int              @id @default(autoincrement())
  city              String
  station           String
  leadName          String
  teamName          String
  dateofCreation    DateTime         @default(now())
  pendingtask       Int              @default(0)
  completedtask     Int              @default(0)
  totalassignedtask Int              @default(0)
  members           Member[]
  tasks             Task[]
  teamDailyStats    TeamDailyStats[]
}

model Member {
  id     Int    @id @default(autoincrement())
  name   String
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks  Task[]
}

model Task {
  id           Int         @id @default(autoincrement())
  assignto     String
  instructions String?
  status       String      @default("pending")
  createdAt    DateTime    @default(now())
  teamId       Int
  memberId     Int
  audio        String[]
  audioTasks   AudioTask[]
  member       Member      @relation(fields: [memberId], references: [id])
  team         Team        @relation(fields: [teamId], references: [id])
}

model AudioTask {
  id       Int    @id @default(autoincrement())
  taskId   Int
  audioUrl String
  status   String @default("pending")
  completionDate DateTime ? 
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  metadata AudioData[]
}


model AudioData {
  id             Int        @id @default(autoincrement())
  audioTaskId    Int?
  city           String
  date           String
  channel        String
  startTime      String?
  endTime        String?
  duration       String?
  contentType    String
  title          String?
  artist         String?
  album          String?
  releaseYear    String?
  language       String?
  brand          String?
  product        String?
  category       String?
  sector         String?
  adType         String?
  programTitle   String?
  programGenre   String?
  seasonNumber   String?
  episodeNumber  String?
  programLang    String?
  sportsTitle    String?
  sportsName     String?
  sportsCategory String?
  sportsLang     String?
  errorType      String?
  audioTask      AudioTask? @relation(fields: [audioTaskId], references: [id], onDelete: Cascade)
}


model TeamDailyStats {
  id       Int      @id @default(autoincrement())
  teamId   Int
  date     DateTime
  assigned Int      @default(0)
  team     Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, date])
}

model AudioFingerprint {
  id          Int      @id @default(autoincrement())
  fileName    String
  filePath    String
  duration    Float
  fingerprint String
  createdAt   DateTime @default(now())
}

model Recording {
  id          Int     @id @default(autoincrement())
  fileName    String
  filePath    String
  duration    Int
  fingerprint String
  jsonPath    String?
}

model MatchResult {
  id          Int      @id @default(autoincrement())
  recordingId Int?
  jsonData    Json
  createdAt   DateTime @default(now())
}

model AudioItem {
  id        String   @id
  audio     String?
  channel   String
  date      DateTime
  start     String
  end       String
  program   String
  region    String
  type      String
  createdAt DateTime @default(now())
}
